<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:id="@id/container_material"
              android:background="@android:color/transparent"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <FrameLayout android:id="@id/pinned_header"
               android:visibility="gone"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content" />
  <com.android.settingslib.readboy.BaseListView android:scrollbarAlwaysDrawVerticalTrack="true"
                        android:scrollbarStyle="@android:integer/preferences_left_pane_weight"
                        android:id="@android:id/list"
                        android:paddingTop="@dimen/dashboard_padding_top"
                        android:paddingBottom="@dimen/dashboard_padding_bottom"
                        android:clipToPadding="false"
                        android:layout_width="fill_parent"
                        android:layout_height="0.0px"
                        android:drawSelectorOnTop="false"
                        android:divider="@drawable/list_divider"
                        android:dividerHeight="1.0px"
                        android:layout_weight="1.0"
                        android:elevation="@dimen/dashboard_category_elevation"
                        style="@style/PreferenceFragmentListSinglePane" />
  <TextView android:textSize="@dimen/preference_item_title_text_size"
            android:textColor="@color/text_1_bg"
            android:gravity="center"
            android:layout_gravity="center_horizontal"
            android:id="@id/wifi_scan"
            android:background="@drawable/radius_button_1_bg"
            android:visibility="gone"
            android:layout_width="@dimen/button_width_2"
            android:layout_height="@dimen/button_height_2"
            android:layout_marginTop="@dimen/space_margin_15"
            android:layout_marginBottom="@dimen/space_margin_15"
            android:text="@string/wifi_menu_scan" />
  <TextView android:gravity="center"
            android:id="@android:id/empty"
            android:padding="@android:dimen/preference_fragment_padding_side"
            android:visibility="gone"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:layout_marginTop="@dimen/space_margin_28"
            android:layout_marginBottom="@dimen/space_margin_28" />
  <RelativeLayout android:id="@id/button_bar"
                  android:visibility="gone"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginLeft="@dimen/local_margin"
                  android:layout_marginRight="@dimen/local_margin"
                  android:layout_marginBottom="22.0dp"
                  android:layout_weight="0.0"
                  android:layout_marginStart="@dimen/local_margin"
                  android:layout_marginEnd="@dimen/local_margin">
    <Button android:id="@id/back_button"
            android:layout_width="150.0dp"
            android:layout_height="wrap_content"
            android:text="@android:string/back_button_label"
            android:layout_alignParentStart="true"
            style="@style/rbButtonStyle" />
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_alignParentEnd="true">
      <Button android:id="@id/skip_button"
              android:visibility="gone"
              android:layout_width="150.0dp"
              android:layout_height="wrap_content"
              android:text="@android:string/sms_short_code_confirm_message"
              style="@style/rbButtonStyle" />
      <Button android:id="@id/next_button"
              android:layout_width="150.0dp"
              android:layout_height="wrap_content"
              android:text="@android:string/noon"
              style="@style/rbButtonStyle" />
    </LinearLayout>
  </RelativeLayout>
</LinearLayout>