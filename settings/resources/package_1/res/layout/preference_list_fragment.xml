<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:id="@id/container_material"
              android:background="@android:color/transparent"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <FrameLayout android:id="@id/pinned_header"
               android:visibility="gone"
               android:layout_width="fill_parent"
               android:layout_height="wrap_content" />
  <FrameLayout android:id="@android:id/list_container"
               android:layout_width="fill_parent"
               android:layout_height="0.0px"
               android:layout_weight="1.0"
               android:paddingStart="@dimen/settings_side_margin"
               android:paddingEnd="@dimen/settings_side_margin">
    <com.android.settingslib.readboy.BaseListView android:scrollbarAlwaysDrawVerticalTrack="true"
                          android:scrollbarStyle="@android:integer/preferences_left_pane_weight"
                          android:id="@id/backup_list"
                          android:paddingTop="@dimen/dashboard_padding_top"
                          android:paddingBottom="@dimen/dashboard_padding_bottom"
                          android:visibility="gone"
                          android:clipToPadding="false"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent"
                          android:drawSelectorOnTop="false"
                          android:elevation="@dimen/dashboard_category_elevation"
                          style="@style/PreferenceFragmentListSinglePane" />
    <include layout="@layout/loading_container" />
  </FrameLayout>
  <TextView android:gravity="center_vertical"
            android:layout_gravity="center"
            android:id="@android:id/empty"
            android:padding="@android:dimen/preference_fragment_padding_side"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="fill_parent" />
  <RelativeLayout android:id="@id/button_bar"
                  android:visibility="gone"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_weight="0.0">
    <Button android:id="@id/back_button"
            android:layout_width="150.0dp"
            android:layout_height="wrap_content"
            android:layout_margin="5.0dp"
            android:text="@android:string/back_button_label"
            android:layout_alignParentStart="true"
            style="@style/rbButtonStyle" />
    <LinearLayout android:orientation="horizontal"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_alignParentEnd="true">
      <Button android:id="@id/skip_button"
              android:visibility="gone"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_margin="5.0dp"
              android:text="@android:string/sms_short_code_confirm_message"
              style="@style/rbButtonStyle" />
      <Button android:id="@id/next_button"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_margin="5.0dp"
              android:text="@android:string/noon"
              style="@style/rbButtonStyle" />
    </LinearLayout>
  </RelativeLayout>
</LinearLayout>