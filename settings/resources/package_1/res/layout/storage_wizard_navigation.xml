<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="horizontal"
              android:id="@id/suw_layout_navigation_bar"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <Button android:id="@id/suw_navbar_back"
          android:visibility="gone"
          android:layout_width="0.0dp"
          android:layout_height="0.0dp"
          style="@style/rbButtonStyle" />
  <View android:layout_width="0.0dp"
        android:layout_height="0.0dp"
        android:layout_weight="1.0" />
  <Button android:id="@id/suw_navbar_more"
          android:visibility="gone"
          android:layout_width="0.0dp"
          android:layout_height="0.0dp"
          style="@style/rbButtonStyle" />
  <Button android:textColor="@color/readboy_text_primary_color"
          android:id="@id/suw_navbar_next"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginTop="16.0dp"
          android:layout_marginBottom="16.0dp"
          android:text="@string/wizard_next"
          android:layout_marginEnd="16.0dp"
          style="@style/rbButtonStyle" />
</LinearLayout>