<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:id="@id/app_detail"
              android:paddingTop="4.0dp"
              android:visibility="gone"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16.0dp"
                android:layout_marginStart="?android:attr/listPreferredItemPaddingStart"
                android:layout_marginEnd="?android:attr/listPreferredItemPaddingEnd">
    <ImageView android:id="@id/app_icon"
               android:layout_width="@dimen/app_icon_size"
               android:layout_height="@dimen/app_icon_size"
               android:scaleType="centerInside"
               android:contentDescription="@null"
               android:layout_marginEnd="8.0dp" />
    <LinearLayout android:orientation="vertical"
                  android:layout_width="0.0dp"
                  android:layout_height="wrap_content"
                  android:layout_marginTop="8.0dp"
                  android:layout_weight="1.0">
      <LinearLayout android:orientation="vertical"
                    android:id="@id/app_titles"
                    android:paddingBottom="4.0dp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:textAlignment="viewStart" />
      <LinearLayout android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <TextView android:textAppearance="@android:style/TextAppearance.Material.Body1"
                  android:textColor="?android:attr/textColorSecondary"
                  android:ellipsize="marquee"
                  android:id="@id/app_title"
                  android:layout_width="0.0dp"
                  android:layout_height="wrap_content"
                  android:text="@string/data_usage_label_foreground"
                  android:singleLine="true"
                  android:layout_weight="1.0"
                  android:textAlignment="viewStart" />
        <TextView android:textAppearance="@android:style/TextAppearance.Material.Body1"
                  android:textColor="?android:attr/textColorSecondary"
                  android:id="@id/app_foreground"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textAlignment="viewEnd" />
      </LinearLayout>
      <LinearLayout android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <TextView android:textAppearance="@android:style/TextAppearance.Material.Body1"
                  android:textColor="?android:attr/textColorSecondary"
                  android:ellipsize="marquee"
                  android:id="@id/app_title"
                  android:layout_width="0.0dp"
                  android:layout_height="wrap_content"
                  android:text="@string/data_usage_label_background"
                  android:singleLine="true"
                  android:layout_weight="1.0"
                  android:textAlignment="viewStart" />
        <TextView android:textAppearance="@android:style/TextAppearance.Material.Body1"
                  android:textColor="?android:attr/textColorSecondary"
                  android:id="@id/app_background"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:textAlignment="viewEnd" />
      </LinearLayout>
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16.0dp"
                android:layout_marginStart="?android:attr/listPreferredItemPaddingStart"
                android:layout_marginEnd="?android:attr/listPreferredItemPaddingEnd">
    <Space android:layout_width="0.0dp"
           android:layout_height="0.0dp"
           android:layout_weight="0.5" />
    <Button android:id="@id/app_settings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/data_usage_app_settings"
            android:layout_weight="0.5"
            style="@style/rbButtonStyle" />
  </LinearLayout>
  <LinearLayout android:orientation="vertical"
                android:id="@id/app_switches"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:divider="?android:attr/listDivider"
                android:showDividers="beginning|middle" />
</LinearLayout>