<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:paddingStart="?android:attr/listPreferredItemPaddingStart"
              android:paddingEnd="?android:attr/listPreferredItemPaddingEnd" xmlns:android="http://schemas.android.com/apk/res/android">
  <TextView android:textAppearance="@style/DreamTextAppearanceSubhead"
            android:textColor="@color/light_black_text_color_nor"
            android:ellipsize="marquee"
            android:gravity="center|left"
            android:id="@id/title"
            android:layout_width="wrap_content"
            android:layout_height="48.0sp"
            android:text="@string/running_processes_header_title"
            android:singleLine="true"
            android:textAlignment="viewStart" />
  <view android:orientation="horizontal"
        android:id="@id/color_bar"
        android:background="@drawable/app_detail_radio_rect_shape_selector0"
        android:layout_width="fill_parent"
        android:layout_height="16.0sp"
        class="com.android.settings.applications.LinearColorBar" />
  <LinearLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="32.0sp"
                android:layout_marginTop="8.0sp">
    <ImageView android:layout_gravity="center"
               android:layout_width="16.0sp"
               android:layout_height="16.0sp"
               android:src="@drawable/app_detail_radio_rect_shape_selector1"
               android:scaleType="centerInside"
               android:contentDescription="@null" />
    <LinearLayout android:layout_gravity="center"
                  android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <TextView android:textAppearance="@style/DreamTextAppearanceBody"
                android:id="@id/systemSizePrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dp"
                android:text="@string/running_processes_header_system_prefix"
                android:maxLines="1" />
      <ImageView android:layout_width="0.0dp"
                 android:layout_height="1.0px"
                 android:src="@drawable/dotted_line_480px"
                 android:scaleType="center"
                 android:baselineAlignBottom="true"
                 android:layout_weight="1.0"
                 android:contentDescription="@null"
                 android:layout_marginStart="1.0dp"
                 android:layout_marginEnd="1.0dp" />
      <TextView android:textAppearance="@style/DreamTextAppearanceBody"
                android:id="@id/systemSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="32.0sp">
    <ImageView android:layout_gravity="center"
               android:layout_width="16.0sp"
               android:layout_height="16.0sp"
               android:src="@drawable/app_detail_radio_rect_shape_selector2"
               android:scaleType="centerInside"
               android:contentDescription="@null" />
    <LinearLayout android:layout_gravity="center"
                  android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <TextView android:textAppearance="@style/DreamTextAppearanceBody"
                android:id="@id/appsSizePrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dp"
                android:text="@string/running_processes_header_apps_prefix"
                android:maxLines="1" />
      <ImageView android:layout_width="0.0dp"
                 android:layout_height="1.0px"
                 android:src="@drawable/dotted_line_480px"
                 android:scaleType="center"
                 android:baselineAlignBottom="true"
                 android:layout_weight="1.0"
                 android:contentDescription="@null"
                 android:layout_marginStart="1.0dp"
                 android:layout_marginEnd="1.0dp" />
      <TextView android:textAppearance="@style/DreamTextAppearanceBody"
                android:id="@id/appsSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />
    </LinearLayout>
  </LinearLayout>
  <LinearLayout android:orientation="horizontal"
                android:layout_width="fill_parent"
                android:layout_height="32.0sp">
    <ImageView android:layout_gravity="center"
               android:layout_width="16.0sp"
               android:layout_height="16.0sp"
               android:src="@drawable/app_detail_radio_rect_shape_selector3"
               android:scaleType="centerInside"
               android:contentDescription="@null" />
    <LinearLayout android:layout_gravity="center"
                  android:orientation="horizontal"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <TextView android:textAppearance="@style/DreamTextAppearanceBody"
                android:id="@id/freeSizePrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="16.0dp"
                android:text="@string/running_processes_header_free_prefix"
                android:maxLines="1" />
      <ImageView android:layout_width="0.0dp"
                 android:layout_height="1.0px"
                 android:src="@drawable/dotted_line_480px"
                 android:scaleType="center"
                 android:baselineAlignBottom="true"
                 android:layout_weight="1.0"
                 android:contentDescription="@null"
                 android:layout_marginStart="1.0dp"
                 android:layout_marginEnd="1.0dp" />
      <TextView android:textAppearance="@style/DreamTextAppearanceBody"
                android:id="@id/freeSize"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1" />
    </LinearLayout>
  </LinearLayout>
  <TextView android:textAppearance="@style/DreamTextAppearanceSubhead"
            android:textColor="@color/light_black_text_color_nor"
            android:ellipsize="marquee"
            android:gravity="center|left"
            android:id="@id/listHeader"
            android:layout_width="wrap_content"
            android:layout_height="48.0dp"
            android:layout_marginTop="8.0sp"
            android:text="@string/running_processes_header_footer"
            android:singleLine="true"
            android:textAlignment="viewStart" />
</LinearLayout>