<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <FrameLayout android:id="@id/pinned_header"
               android:visibility="gone"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content" />
  <com.android.settings.view.LocalPagerTitleStrip android:id="@id/tabs"
                        android:layout_width="fill_parent"
                        android:layout_height="@dimen/button_height_2"
                        android:layout_marginTop="20.0dp" />
  <RelativeLayout android:layout_width="fill_parent"
                  android:layout_height="@dimen/button_height_2"
                  android:layout_marginTop="10.0dp">
    <EditText android:id="@id/edit_search_text"
              android:background="@drawable/full_radius_edit_bg"
              android:paddingLeft="20.0dp"
              android:paddingRight="110.0dp"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:hint="@string/app_search_edit_hint"
              android:singleLine="true"
              android:maxLength="16"
              android:imeOptions="actionSearch" />
    <Button android:id="@id/btn_clean_search"
            android:background="@drawable/btn_delete_search_selector"
            android:layout_width="25.0dp"
            android:layout_height="25.0dp"
            android:layout_marginRight="60.0dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
    <Button android:id="@id/btn_start_search"
            android:background="@drawable/btn_start_search_apps_selector"
            android:layout_width="29.0dp"
            android:layout_height="29.0dp"
            android:layout_marginRight="20.0dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
  </RelativeLayout>
  <View android:background="?android:attr/listDivider"
        android:layout_width="fill_parent"
        android:layout_height="1.0px"
        android:layout_marginTop="10.0dp" />
  <android.support.v4.view.ViewPager android:id="@id/pager"
                        android:layout_width="fill_parent"
                        android:layout_height="fill_parent"
                        android:layout_weight="1.0" />
  <FrameLayout android:layout_gravity="center_horizontal"
               android:id="@id/more_content"
               android:layout_width="@dimen/button_width_3"
               android:layout_height="wrap_content">
    <TextView android:textSize="@dimen/preference_item_title_text_size"
              android:textColor="@color/text_1_bg"
              android:gravity="center"
              android:layout_gravity="center_horizontal"
              android:id="@id/more"
              android:background="@drawable/radius_button_1_bg"
              android:layout_width="@dimen/button_width_2"
              android:layout_height="@dimen/button_height_2"
              android:layout_marginTop="@dimen/space_margin_15"
              android:layout_marginBottom="@dimen/space_margin_15"
              android:text="@string/more_label" />
  </FrameLayout>
</LinearLayout>