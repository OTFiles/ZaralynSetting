<?xml version='1.0' encoding='utf-8' ?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
  <View android:background="@color/readboy_windowBackground"
        android:layout_width="fill_parent"
        android:layout_height="0.0dp" />
  <LinearLayout android:orientation="horizontal"
                android:id="@id/root_switch_bar_layout"
                android:background="@drawable/app_bottom_top_line_border_white_bg"
                android:layout_width="fill_parent"
                android:layout_height="69.0dp"
                android:layout_marginLeft="@dimen/settings_side_big_margin"
                android:layout_marginRight="@dimen/settings_side_big_margin">
    <LinearLayout android:gravity="center_vertical"
                  android:layout_gravity="center_vertical"
                  android:orientation="vertical"
                  android:layout_width="0.0dp"
                  android:layout_height="?android:attr/actionBarSize"
                  android:layout_weight="1.0"
                  android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                  android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">
      <TextView android:textAppearance="?android:attr/textAppearanceListItem"
                android:textColor="@color/readboy_text_primary_color"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@id/switch_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textAlignment="viewStart" />
      <TextView android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                android:textColor="@color/readboy_text_secondary_color"
                android:ellipsize="end"
                android:layout_gravity="center_vertical"
                android:id="@id/switch_summary"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textAlignment="viewStart" />
    </LinearLayout>
    <ImageView android:theme="@android:style/Theme.Material"
               android:layout_gravity="center_vertical"
               android:id="@id/restricted_icon"
               android:visibility="gone"
               android:layout_width="28.0dp"
               android:layout_height="28.0dp"
               android:src="@drawable/ic_tab_selected_all"
               android:layout_marginEnd="@dimen/restricted_icon_margin_end" />
    <com.android.settings.widget.ToggleSwitch android:theme="@style/ThemeOverlay.SwitchBar.Settings"
                          android:layout_gravity="center_vertical"
                          android:id="@id/switch_widget"
                          android:background="@null"
                          android:layout_width="wrap_content"
                          android:layout_height="wrap_content"
                          android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                          android:paddingEnd="?android:attr/listPreferredItemPaddingEnd" />
  </LinearLayout>
</merge>