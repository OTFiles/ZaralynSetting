<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="horizontal"
              android:id="@id/rl_content_main_container"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <RelativeLayout android:id="@id/rl_main_right_container"
                  android:paddingTop="0.0dp"
                  android:paddingBottom="@dimen/activity_history_vertical_margin_bottom"
                  android:layout_width="fill_parent"
                  android:layout_height="fill_parent">
    <LinearLayout android:orientation="vertical"
                  android:id="@id/ll_main_tip_container"
                  android:paddingTop="@dimen/activity_history_vertical_margin_2"
                  android:paddingBottom="16.0dp"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <RelativeLayout android:id="@id/rl_main_split_screen_switch"
                      android:paddingBottom="16.0dp"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">
        <TextView android:textAppearance="?android:attr/textAppearanceListItem"
                  android:textColor="@color/ntf_activity_title_color1"
                  android:id="@id/tv_main_split_screen_switch_title"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="@string/readboy_allow_split_screen_title"
                  android:layout_alignParentLeft="true" />
        <TextView android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                  android:textColor="?android:attr/textColorSecondary"
                  android:id="@id/tv_main_split_screen_switch_summary"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="@string/readboy_allow_split_screen_summary"
                  android:layout_below="@id/tv_main_split_screen_switch_title"
                  android:layout_alignParentLeft="true" />
        <TextView android:id="@id/tv_main_split_screen_switch_check"
                  android:background="@drawable/btn_checked_selector"
                  android:visibility="visible"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_alignParentRight="true"
                  android:layout_centerVertical="true" />
      </RelativeLayout>
      <TextView android:id="@id/tv_diliver_01"
                android:background="@color/ntf_diliver_color2"
                android:layout_width="fill_parent"
                android:layout_height="1.0dp"
                android:layout_marginBottom="16.0dp"
                android:layout_below="@id/rl_main_split_screen_switch" />
      <RelativeLayout android:id="@id/rl_main_tip_switch"
                      android:paddingBottom="16.0dp"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">
        <TextView android:textAppearance="?android:attr/textAppearanceListItem"
                  android:textColor="@color/ntf_activity_title_color1"
                  android:id="@id/tv_main_tip_switch_title"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="@string/readboy_force_portrait_app_landscape_switch_title"
                  android:layout_alignParentLeft="true" />
        <TextView android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                  android:textColor="?android:attr/textColorSecondary"
                  android:id="@id/tv_main_tip_switch_summary"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:text="@string/readboy_force_portrait_app_landscape_switch_summary"
                  android:layout_below="@id/tv_main_tip_switch_title"
                  android:layout_alignParentLeft="true" />
        <TextView android:id="@id/tv_main_tip_switch_check"
                  android:background="@drawable/btn_checked_selector"
                  android:visibility="visible"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_alignParentRight="true"
                  android:layout_centerVertical="true" />
      </RelativeLayout>
      <TextView android:id="@id/tv_diliver_1"
                android:background="@color/ntf_diliver_color2"
                android:layout_width="fill_parent"
                android:layout_height="1.0dp"
                android:layout_below="@id/rl_main_tip_switch" />
      <TextView android:textSize="25.0dp"
                android:textColor="@color/ntf_activity_title_color1"
                android:id="@id/tv_main_tip_title"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:text="@string/readboy_force_portrait_app_landscape_title" />
      <TextView android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@id/tv_main_tip_summary"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dp"
                android:text="@string/readboy_force_portrait_app_landscape_detail" />
    </LinearLayout>
    <TextView android:id="@id/tv_diliver_2"
              android:background="@color/ntf_diliver_color2"
              android:layout_width="fill_parent"
              android:layout_height="1.0dp"
              android:layout_below="@id/ll_main_tip_container" />
    <RelativeLayout android:id="@id/search_edit_container"
                    android:layout_width="fill_parent"
                    android:layout_height="41.0dp"
                    android:layout_marginTop="22.0dp"
                    android:layout_marginBottom="22.0dp"
                    android:layout_below="@id/tv_diliver_2"
                    android:layout_marginStart="0.0dp"
                    android:layout_marginEnd="0.0dp">
      <EditText android:id="@id/edit_search_text"
                android:background="@drawable/edittext_full_radius_edit_bg"
                android:paddingLeft="20.0dp"
                android:paddingRight="110.0dp"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:hint="@string/app_search_edit_hint"
                android:singleLine="true"
                android:maxLength="16"
                android:imeOptions="actionSearch" />
      <Button android:id="@id/btn_clean_search"
              android:background="@drawable/btn_delete_search_selector"
              android:layout_width="25.0dp"
              android:layout_height="25.0dp"
              android:layout_marginRight="60.0dp"
              android:layout_alignParentRight="true"
              android:layout_centerVertical="true" />
      <Button android:id="@id/btn_start_search"
              android:background="@drawable/btn_start_search_apps_selector"
              android:layout_width="29.0dp"
              android:layout_height="29.0dp"
              android:layout_marginRight="20.0dp"
              android:layout_alignParentRight="true"
              android:layout_centerVertical="true" />
    </RelativeLayout>
    <TextView android:id="@id/tv_diliver_3"
              android:background="@color/ntf_diliver_color2"
              android:layout_width="fill_parent"
              android:layout_height="1.0px"
              android:layout_below="@id/search_edit_container" />
    <RelativeLayout android:layout_width="fill_parent"
                    android:layout_height="fill_parent"
                    android:layout_below="@id/tv_diliver_3">
      <com.android.settingslib.readboy.BaseRecyclerView android:id="@id/recycler_white_list"
                            android:layout_width="fill_parent"
                            android:layout_height="fill_parent" />
    </RelativeLayout>
    <LinearLayout android:gravity="center"
                  android:orientation="vertical"
                  android:id="@id/ll_white_list_empty_container"
                  android:layout_width="fill_parent"
                  android:layout_height="fill_parent">
      <ProgressBar android:layout_gravity="center_horizontal"
                   android:id="@id/progressbar_white_list_empty_loading"
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:indeterminateDrawable="@drawable/ntf_loading_anim"
                   android:indeterminateBehavior="repeat" />
      <TextView android:textSize="16.0dp"
                android:textColor="@color/ntf_activity_title_color3"
                android:layout_gravity="center_horizontal"
                android:id="@id/tv_white_list_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dp"
                android:text="@string/app_search_wait_loading" />
    </LinearLayout>
  </RelativeLayout>
</LinearLayout>