<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:id="@id/all_switch_button"
                android:background="?android:attr/selectableItemBackground"
                android:paddingTop="16.0dp"
                android:paddingBottom="16.0dp"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">
    <TextView android:textSize="@dimen/preference_item_title_text_size"
              android:textColor="@color/readboy_text_back_arrow_color"
              android:gravity="center_vertical"
              android:id="@id/all_title"
              android:layout_width="wrap_content"
              android:layout_height="fill_parent"
              android:layout_weight="1.0" />
    <Switch android:layout_gravity="center_vertical"
            android:id="@id/all_switch"
            android:clickable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="3.0dp" />
  </LinearLayout>
  <RelativeLayout android:id="@id/search_edit_container"
                  android:layout_width="fill_parent"
                  android:layout_height="41.0dp"
                  android:layout_marginTop="22.0dp"
                  android:layout_marginBottom="22.0dp">
    <EditText android:id="@id/edit_search_text"
              android:background="@drawable/edittext_full_radius_edit_bg"
              android:paddingLeft="20.0dp"
              android:paddingRight="110.0dp"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:hint="@string/app_search_edit_hint"
              android:singleLine="true"
              android:maxLength="16"
              android:imeOptions="actionSearch" />
    <Button android:id="@id/btn_clean_search"
            android:background="@drawable/btn_delete_search_selector"
            android:layout_width="25.0dp"
            android:layout_height="25.0dp"
            android:layout_marginRight="60.0dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
    <Button android:id="@id/btn_start_search"
            android:background="@drawable/btn_start_search_apps_selector"
            android:layout_width="29.0dp"
            android:layout_height="29.0dp"
            android:layout_marginRight="20.0dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true" />
  </RelativeLayout>
  <View android:background="?android:attr/listDivider"
        android:visibility="gone"
        android:layout_width="fill_parent"
        android:layout_height="1.0dp"
        android:layout_marginLeft="?android:attr/listPreferredItemPaddingStart"
        android:layout_marginRight="?android:attr/listPreferredItemPaddingEnd" />
  <RelativeLayout android:clipToPadding="false"
                  android:layout_width="fill_parent"
                  android:layout_height="0.0px"
                  android:layout_weight="1.0">
    <com.android.settingslib.readboy.BaseListView android:scrollbarAlwaysDrawVerticalTrack="true"
                          android:scrollbarStyle="@android:integer/preferences_left_pane_weight"
                          android:id="@android:id/list"
                          android:clipToPadding="false"
                          android:layout_width="fill_parent"
                          android:layout_height="fill_parent"
                          android:drawSelectorOnTop="false"
                          android:divider="@null"
                          android:dividerHeight="0.0dp"
                          android:elevation="@dimen/dashboard_category_elevation"
                          style="@style/PreferenceFragmentListSinglePane" />
    <TextView android:textAppearance="?android:attr/textAppearanceMedium"
              android:gravity="center"
              android:id="@android:id/empty"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:text="@string/loading_notification_apps" />
  </RelativeLayout>
</LinearLayout>