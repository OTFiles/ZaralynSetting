<?xml version='1.0' encoding='utf-8' ?>
<com.android.settingslib.readboy.BaseScrollView android:orientation="vertical"
                      android:id="@id/container"
                      android:layout_width="fill_parent"
                      android:layout_height="fill_parent"
                      android:fillViewport="true" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:orientation="vertical"
                android:id="@id/dialog_container"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent">
    <com.android.settingslib.notification.ZenRadioLayout android:orientation="horizontal"
                          android:id="@id/zen_conditions"
                          android:paddingBottom="4.0dp"
                          android:layout_width="fill_parent"
                          android:layout_height="wrap_content"
                          android:layout_marginTop="8.0dp"
                          android:layout_marginStart="4.0dp"
                          android:layout_marginEnd="4.0dp">
      <RadioGroup android:id="@id/zen_radio_buttons"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content" />
      <LinearLayout android:orientation="vertical"
                    android:id="@id/zen_radio_buttons_content"
                    android:layout_width="fill_parent"
                    android:layout_height="fill_parent" />
    </com.android.settingslib.notification.ZenRadioLayout>
    <TextView android:textColor="?android:attr/colorError"
              android:id="@id/zen_alarm_warning"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:textDirection="locale"
              android:layout_marginStart="18.0dp"
              android:layout_marginEnd="16.0dp" />
  </LinearLayout>
</com.android.settingslib.readboy.BaseScrollView>