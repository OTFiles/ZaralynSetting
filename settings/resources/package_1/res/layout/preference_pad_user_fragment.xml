<?xml version='1.0' encoding='utf-8' ?>
<com.android.settings.NavigationBarScrollView android:layout_width="fill_parent"
                      android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <RelativeLayout android:id="@id/pad_user_container"
                  android:layout_width="fill_parent"
                  android:layout_height="fill_parent">
    <RelativeLayout android:gravity="center_vertical"
                    android:id="@id/pad_user_student_mode"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="16.0dp"
                    android:paddingBottom="16.0dp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
      <TextView android:textAppearance="?android:attr/textAppearanceListItem"
                android:id="@id/pad_user_student_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/readboy_pad_user_mode_student_title" />
      <TextView android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@id/pad_user_student_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/readboy_pad_user_mode_student_summary"
                android:layout_below="@id/pad_user_student_title" />
      <TextView android:id="@id/btn_pad_user_student"
                android:background="@drawable/btn_choose_navigation_bar_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5.0dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
    </RelativeLayout>
    <View android:id="@id/middle_filter_splite_line_1"
          android:background="@color/divider_line_color"
          android:layout_width="fill_parent"
          android:layout_height="1.0px"
          android:layout_below="@id/pad_user_student_mode" />
    <RelativeLayout android:gravity="center_vertical"
                    android:id="@id/pad_user_adult_mode"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="16.0dp"
                    android:paddingBottom="16.0dp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/middle_filter_splite_line_1">
      <TextView android:textAppearance="?android:attr/textAppearanceListItem"
                android:id="@id/pad_user_adult_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/readboy_pad_user_mode_adult_title" />
      <TextView android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                android:textColor="?android:attr/textColorSecondary"
                android:id="@id/pad_user_adult_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/readboy_pad_user_mode_adult_summary"
                android:layout_below="@id/pad_user_adult_title" />
      <TextView android:id="@id/btn_pad_user_adult"
                android:background="@drawable/btn_choose_navigation_bar_selector"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginRight="5.0dp"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true" />
    </RelativeLayout>
    <View android:id="@id/middle_filter_splite_line_2"
          android:background="@color/divider_line_color"
          android:layout_width="fill_parent"
          android:layout_height="1.0px"
          android:layout_below="@id/pad_user_adult_mode" />
    <RelativeLayout android:gravity="center_vertical"
                    android:id="@id/pad_user_parent_password"
                    android:background="?android:attr/selectableItemBackground"
                    android:paddingTop="16.0dp"
                    android:paddingBottom="16.0dp"
                    android:clickable="true"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/middle_filter_splite_line_2">
      <TextView android:textAppearance="?android:attr/textAppearanceListItem"
                android:id="@id/pad_user_parent_password_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/readboy_pad_user_set_parent_password_title" />
      <ImageView android:layout_width="wrap_content"
                 android:layout_height="wrap_content"
                 android:layout_marginRight="5.0dp"
                 android:src="@drawable/arrow_nor"
                 android:layout_alignParentRight="true"
                 android:layout_centerVertical="true" />
    </RelativeLayout>
    <View android:id="@id/middle_filter_splite_line_3"
          android:background="@color/divider_line_color"
          android:layout_width="fill_parent"
          android:layout_height="1.0px"
          android:layout_below="@id/pad_user_parent_password" />
  </RelativeLayout>
</com.android.settings.NavigationBarScrollView>