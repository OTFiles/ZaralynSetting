<?xml version='1.0' encoding='utf-8' ?>
<GridLayout android:paddingTop="8.0dp"
            android:paddingBottom="8.0dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="?android:attr/listPreferredItemHeight"
            android:columnCount="2"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd" xmlns:android="http://schemas.android.com/apk/res/android">
  <ImageView android:layout_gravity="center_vertical"
             android:id="@id/icon"
             android:layout_width="@dimen/app_icon_size"
             android:layout_height="@dimen/app_icon_size"
             android:src="@drawable/app_icon_cover_bound"
             android:scaleType="fitXY"
             android:contentDescription="@null"
             android:layout_rowSpan="2"
             android:layout_marginEnd="8.0dp" />
  <LinearLayout android:layout_gravity="fill_horizontal"
                android:layout_width="0.0dp"
                android:layout_marginTop="2.0dp">
    <TextView android:textAppearance="@style/DreamTextAppearanceSubhead"
              android:ellipsize="marquee"
              android:id="@id/name"
              android:layout_width="0.0dp"
              android:layout_height="wrap_content"
              android:singleLine="true"
              android:layout_weight="1.0"
              android:textAlignment="viewStart" />
    <TextView android:textAppearance="@style/DreamTextAppearanceBody"
              android:id="@id/size"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="8.0dp" />
  </LinearLayout>
  <LinearLayout android:layout_gravity="center|fill_horizontal|top"
                android:layout_width="0.0dp">
    <TextView android:textAppearance="@style/DreamTextAppearanceBody"
              android:id="@id/description"
              android:layout_width="0.0dp"
              android:layout_height="wrap_content"
              android:layout_weight="1.0"
              android:textAlignment="viewStart" />
    <TextView android:textAppearance="@style/DreamTextAppearanceBody"
              android:id="@id/uptime"
              android:layout_width="wrap_content"
              android:layout_height="wrap_content"
              android:layout_marginStart="8.0dp" />
  </LinearLayout>
</GridLayout>