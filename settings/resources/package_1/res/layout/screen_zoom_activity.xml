<?xml version='1.0' encoding='utf-8' ?>
<com.android.settingslib.readboy.BaseScrollView android:layout_width="fill_parent"
                      android:layout_height="fill_parent"
                      android:fillViewport="true" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <include layout="@layout/preview_seek_bar_view_pager" />
    <LinearLayout android:orientation="vertical"
                  android:paddingTop="16.0dp"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_marginRight="25.0dp"
                  android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                  android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">
      <com.android.settings.widget.DotsPageIndicator android:layout_gravity="center_horizontal"
                            android:id="@id/page_indicator"
                            android:padding="6.0dp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            style="@style/PreviewPagerPageIndicator" />
      <TextView android:textAppearance="@android:style/TextAppearance.Material.Widget.TextView"
                android:layout_gravity="center_horizontal"
                android:id="@id/current_label"
                android:padding="6.0dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:elevation="0.0dp" />
      <LinearLayout android:gravity="center_vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content">
        <ImageView android:id="@id/smaller"
                   android:background="?android:attr/selectableItemBackgroundBorderless"
                   android:focusable="true"
                   android:layout_width="48.0dp"
                   android:layout_height="48.0dp"
                   android:src="@drawable/ic_remove_24dp"
                   android:scaleType="center"
                   android:tint="?android:attr/textColorPrimary"
                   android:contentDescription="@string/screen_zoom_make_smaller_desc"
                   android:tintMode="src_in" />
        <com.android.settings.widget.LabeledSeekBar android:id="@id/seek_bar"
                              android:layout_width="0.0dp"
                              android:layout_height="48.0dp"
                              android:layout_weight="1.0"
                              style="@android:style/Widget.Material.SeekBar.Discrete" />
        <ImageView android:id="@id/larger"
                   android:background="?android:attr/selectableItemBackgroundBorderless"
                   android:focusable="true"
                   android:layout_width="48.0dp"
                   android:layout_height="48.0dp"
                   android:src="@drawable/ic_add_24dp"
                   android:scaleType="center"
                   android:tint="?android:attr/textColorPrimary"
                   android:contentDescription="@string/screen_zoom_make_larger_desc"
                   android:tintMode="src_in" />
      </LinearLayout>
      <TextView android:textAppearance="@android:style/TextAppearance.Material.Subhead"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16.0dp"
                android:text="@string/screen_zoom_summary" />
    </LinearLayout>
  </LinearLayout>
</com.android.settingslib.readboy.BaseScrollView>