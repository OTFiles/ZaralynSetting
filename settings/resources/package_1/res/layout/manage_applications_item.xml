<?xml version='1.0' encoding='utf-8' ?>
<GridLayout android:paddingTop="8.0dp"
            android:paddingBottom="8.0dp"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:minHeight="?android:attr/listPreferredItemHeight"
            android:columnCount="4"
            android:paddingStart="?android:attr/listPreferredItemPaddingStart"
            android:paddingEnd="?android:attr/listPreferredItemPaddingEnd" xmlns:android="http://schemas.android.com/apk/res/android">
  <ImageView android:id="@id/app_icon"
             android:layout_width="@dimen/app_icon_size"
             android:layout_height="@dimen/app_icon_size"
             android:scaleType="centerInside"
             android:contentDescription="@null"
             android:layout_rowSpan="2"
             android:layout_marginEnd="8.0dp" />
  <TextView android:textAppearance="@style/DreamTextAppearanceSubhead"
            android:ellipsize="marquee"
            android:layout_gravity="fill_horizontal"
            android:id="@id/app_name"
            android:layout_width="0.0dp"
            android:layout_marginTop="2.0dp"
            android:singleLine="true"
            android:layout_columnSpan="2"
            android:textAlignment="viewStart" />
  <CheckBox android:layout_gravity="center_vertical"
            android:id="@id/app_on_sdcard"
            android:focusable="false"
            android:visibility="gone"
            android:clickable="false"
            android:layout_rowSpan="2"
            android:layout_marginStart="8.0dp" />
  <TextView android:textAppearance="@style/DreamTextAppearanceBody"
            android:layout_gravity="center|fill_horizontal|top"
            android:id="@id/app_size"
            android:layout_column="1"
            android:layout_row="1"
            android:textAlignment="viewStart" />
  <TextView android:textAppearance="@style/DreamTextAppearanceBody"
            android:textColor="?android:attr/textColorSecondary"
            android:ellipsize="marquee"
            android:layout_gravity="center|fill_horizontal|top"
            android:id="@id/app_disabled"
            android:layout_width="0.0dp"
            android:singleLine="true"
            android:textAlignment="viewEnd"
            android:layout_marginStart="8.0dp" />
</GridLayout>