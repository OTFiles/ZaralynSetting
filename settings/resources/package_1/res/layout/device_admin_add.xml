<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:id="@id/active_layout"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <com.android.settingslib.readboy.BaseScrollView android:scrollbarStyle="outsideOverlay"
                        android:gravity="top"
                        android:layout_width="fill_parent"
                        android:layout_height="0.0dp"
                        android:layout_weight="1.0">
    <LinearLayout android:orientation="vertical"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <LinearLayout android:orientation="horizontal"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="30.0dp"
                    android:paddingStart="@dimen/settings_side_margin"
                    android:paddingEnd="@dimen/settings_side_margin">
        <ImageView android:layout_gravity="center_vertical"
                   android:id="@id/admin_icon"
                   android:layout_width="@dimen/app_icon_size"
                   android:layout_height="@dimen/app_icon_size"
                   android:scaleType="fitCenter"
                   android:contentDescription="@null"
                   android:layout_marginEnd="16.0dp" />
        <TextView android:textAppearance="?android:attr/textAppearanceMedium"
                  android:textStyle="bold"
                  android:ellipsize="marquee"
                  android:layout_gravity="center_vertical"
                  android:id="@id/admin_name"
                  android:layout_width="wrap_content"
                  android:layout_height="wrap_content"
                  android:layout_marginBottom="2.0dp"
                  android:singleLine="true"
                  android:layout_weight="1.0" />
      </LinearLayout>
      <LinearLayout android:orientation="vertical"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="@dimen/settings_side_margin"
                    android:paddingEnd="@dimen/settings_side_margin">
        <TextView android:id="@id/profile_owner_warning"
                  android:padding="0.0dp"
                  android:visibility="gone"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:text="@string/adding_profile_owner_warning" />
        <TextView android:id="@id/admin_description"
                  android:padding="0.0dp"
                  android:layout_width="fill_parent"
                  android:layout_height="0.0dp"
                  android:layout_weight="0.0" />
        <LinearLayout android:gravity="center_vertical"
                      android:orientation="horizontal"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content">
          <ImageView android:gravity="center_vertical"
                     android:id="@id/add_msg_expander"
                     android:layout_width="wrap_content"
                     android:layout_height="wrap_content"
                     android:contentDescription="@null" />
          <TextView android:gravity="center_vertical"
                    android:id="@id/add_msg"
                    android:padding="10.0dp"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content" />
        </LinearLayout>
        <TextView android:textAppearance="?android:attr/textAppearanceMedium"
                  android:id="@id/admin_warning"
                  android:padding="10.0dp"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:layout_weight="1.0" />
        <LinearLayout android:orientation="vertical"
                      android:id="@id/admin_policies"
                      android:layout_width="fill_parent"
                      android:layout_height="wrap_content"
                      android:layout_weight="1.0"
                      android:paddingStart="16.0dp"
                      android:paddingEnd="12.0dp" />
        <TextView android:textAppearance="?android:attr/textAppearanceMedium"
                  android:autoLink="email|phone|web"
                  android:id="@id/admin_support_message"
                  android:padding="10.0dp"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content" />
      </LinearLayout>
      <LinearLayout android:orientation="vertical"
                    android:id="@id/buttonPanel"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:divider="?android:attr/dividerHorizontal"
                    android:showDividers="beginning|end|middle"
                    android:paddingStart="@dimen/settings_side_margin"
                    android:paddingEnd="@dimen/settings_side_margin"
                    style="?android:attr/buttonBarStyle">
        <LinearLayout android:gravity="center_vertical"
                      android:orientation="horizontal"
                      android:id="@id/restricted_action"
                      android:layout_width="wrap_content"
                      android:layout_height="wrap_content">
          <Button android:gravity="center|start"
                  android:layout_gravity="start"
                  android:id="@id/action_button"
                  android:focusable="false"
                  android:clickable="false"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content"
                  android:maxLines="2"
                  android:textAllCaps="false"
                  android:paddingStart="@dimen/settings_side_margin"
                  android:paddingEnd="@dimen/settings_side_margin"
                  style="@style/rbButtonStyle" />
          <include layout="@layout/restricted_icon" />
        </LinearLayout>
        <Button android:gravity="center"
                android:layout_gravity="left"
                android:id="@id/cancel_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:hint="@string/readboy_ai_assist_wakeup_switch_title"
                android:maxLines="2"
                android:textAllCaps="false"
                android:paddingStart="@dimen/settings_side_margin"
                android:paddingEnd="@dimen/settings_side_margin"
                style="@style/rbButtonStyle" />
        <Button android:gravity="center"
                android:layout_gravity="left"
                android:id="@id/uninstall_button"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/uninstall_device_admin"
                android:hint="@string/readboy_ai_assist_wakeup_switch_title"
                android:maxLines="2"
                android:textAllCaps="false"
                android:paddingStart="@dimen/settings_side_margin"
                android:paddingEnd="@dimen/settings_side_margin"
                style="@style/rbButtonStyle" />
      </LinearLayout>
    </LinearLayout>
  </com.android.settingslib.readboy.BaseScrollView>
</LinearLayout>