<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent"
              android:paddingStart="@dimen/preference_no_icon_padding_start_settings"
              android:paddingEnd="?android:attr/listPreferredItemPaddingEnd" xmlns:android="http://schemas.android.com/apk/res/android">
  <com.android.settingslib.readboy.BaseScrollView android:layout_width="fill_parent"
                        android:layout_height="0.0dp"
                        android:layout_marginTop="16.0dp"
                        android:layout_weight="1.0">
    <LinearLayout android:orientation="vertical"
                  android:layout_width="fill_parent"
                  android:layout_height="wrap_content">
      <TextView android:textAppearance="?android:attr/textAppearanceMedium"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8.0dp"
                android:layout_marginBottom="16.0dp"
                android:text="@string/crypt_keeper_desc" />
      <TextView android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:id="@id/warning_low_charge"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dp"
                android:text="@string/crypt_keeper_low_charge_text" />
      <TextView android:textAppearance="?android:attr/textAppearanceMedium"
                android:textStyle="bold"
                android:id="@id/warning_unplugged"
                android:visibility="gone"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16.0dp"
                android:text="@string/crypt_keeper_unplugged_text" />
    </LinearLayout>
  </com.android.settingslib.readboy.BaseScrollView>
  <Button android:layout_gravity="end"
          android:id="@id/initiate_encrypt"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:text="@string/crypt_keeper_button_text"
          style="@style/ActionPrimaryButton" />
</LinearLayout>