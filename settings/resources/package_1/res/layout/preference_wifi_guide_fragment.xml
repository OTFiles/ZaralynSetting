<?xml version='1.0' encoding='utf-8' ?>
<LinearLayout android:orientation="vertical"
              android:background="#ffffff"
              android:layout_width="fill_parent"
              android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <include android:id="@id/guide_data_switch_layout"
           android:background="#ffffffff"
           android:layout_width="fill_parent"
           android:layout_height="wrap_content"
           android:layout_marginTop="20.0dp"
           android:layout_marginBottom="0.0dp"
           layout="@layout/preference_wilan_guide_data_switch" />
  <include android:id="@id/guide_wifi_switch_layout"
           android:background="#ffffffff"
           android:layout_width="fill_parent"
           android:layout_height="wrap_content"
           layout="@layout/preference_wilan_guide_wifi_switch" />
  <RelativeLayout android:id="@id/guide_scan_wifi_hot_anim"
                  android:visibility="gone"
                  android:layout_width="fill_parent"
                  android:layout_height="0.0dp"
                  android:layout_weight="2.0">
    <ImageView android:background="@drawable/guide_wifi_scan_anim"
               android:layout_width="@dimen/guide_loading_anim_height"
               android:layout_height="@dimen/guide_loading_anim_height"
               android:layout_marginBottom="20.0dp"
               android:layout_alignParentBottom="true"
               android:layout_centerHorizontal="true" />
  </RelativeLayout>
  <FrameLayout android:id="@id/container"
               android:background="#ffffffff"
               android:layout_width="fill_parent"
               android:layout_height="0.0dp"
               android:layout_weight="1.0" />
  <LinearLayout android:gravity="center_horizontal"
                android:id="@id/guide_wifi_scan_container"
                android:background="#ffffffff"
                android:paddingTop="20.0dp"
                android:paddingBottom="32.0dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <TextView android:textSize="@dimen/guide_text_size_6"
              android:textColor="@color/text_1_bg_guide"
              android:gravity="center"
              android:layout_gravity="center_horizontal"
              android:id="@id/wifi_scan"
              android:background="@drawable/app_detail_fun_button_guide_selector"
              android:layout_width="120.0dp"
              android:layout_height="48.0dp"
              android:text="@string/wifi_menu_scan" />
  </LinearLayout>
</LinearLayout>