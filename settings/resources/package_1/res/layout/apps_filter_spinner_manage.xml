<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:gravity="center_vertical"
                android:layout_width="fill_parent"
                android:layout_height="?android:attr/listPreferredItemHeightSmall" xmlns:android="http://schemas.android.com/apk/res/android">
  <RelativeLayout android:gravity="center_vertical"
                  android:background="?android:attr/activatedBackgroundIndicator"
                  android:layout_width="fill_parent"
                  android:layout_height="?android:attr/listPreferredItemHeightSmall"
                  android:layout_marginLeft="@dimen/readboy_app_padding_start_1"
                  android:layout_marginRight="@dimen/readboy_app_padding_end_1"
                  android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                  android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">
    <Spinner android:textColor="@color/readboy_text_primary_color"
             android:gravity="center_vertical"
             android:id="@id/filter_spinner"
             android:layout_width="fill_parent"
             android:layout_height="fill_parent"
             android:layout_centerVertical="true"
             android:layout_alignWithParentIfMissing="true"
             android:textAlignment="viewStart"
             android:layout_marginStart="0.0dp"
             android:layout_marginEnd="0.0dp"
             android:layout_alignParentStart="true" />
    <ImageView android:id="@id/filter_settings"
               android:visibility="gone"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:src="@drawable/ic_bt_config"
               android:scaleType="center"
               android:minWidth="0.0dp"
               android:minHeight="0.0dp"
               android:layout_centerVertical="true"
               android:contentDescription="@string/configure"
               android:layout_alignParentEnd="true"
               style="?android:attr/borderlessButtonStyle" />
  </RelativeLayout>
  <View android:background="@color/list_divider_extra_color"
        android:layout_width="fill_parent"
        android:layout_height="@dimen/readboy_sub_divider_height"
        android:layout_alignParentBottom="true" />
</RelativeLayout>