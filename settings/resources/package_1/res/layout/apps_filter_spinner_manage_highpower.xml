<?xml version='1.0' encoding='utf-8' ?>
<RelativeLayout android:gravity="center_vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:orientation="vertical"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content">
    <FrameLayout android:gravity="center_vertical"
                 android:orientation="vertical"
                 android:background="?android:attr/activatedBackgroundIndicator"
                 android:layout_width="fill_parent"
                 android:layout_height="wrap_content"
                 android:layout_marginLeft="30.0dp"
                 android:layout_marginRight="12.0dp"
                 android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                 android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">
      <TextView android:textAppearance="?android:attr/textAppearanceListItemSecondary"
                android:textColor="@color/readboy_text_secondary_color"
                android:gravity="center_vertical"
                android:id="@id/filter_instruction"
                android:paddingLeft="7.0dp"
                android:paddingTop="36.0dp"
                android:paddingRight="36.0dp"
                android:paddingBottom="9.0dp"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="72.0dp"
                android:text="@string/battery_optimization_Instructions_all_appp"
                android:maxLines="100"
                android:layout_below="@id/filter_spinner"
                android:layout_alignStart="@id/filter_spinner" />
      <Spinner android:textColor="@color/readboy_text_primary_color"
               android:gravity="center_vertical"
               android:id="@id/filter_spinner"
               android:paddingTop="9.0dp"
               android:paddingBottom="34.0dp"
               android:layout_width="fill_parent"
               android:layout_height="wrap_content"
               android:minHeight="72.0dp"
               android:layout_alignWithParentIfMissing="true"
               android:textAlignment="viewStart"
               android:layout_marginStart="0.0dp"
               android:layout_marginEnd="0.0dp"
               android:layout_alignParentStart="true" />
    </FrameLayout>
    <View android:background="@color/list_divider_extra_color"
          android:layout_width="fill_parent"
          android:layout_height="@dimen/readboy_sub_divider_height"
          android:layout_alignParentBottom="true" />
  </LinearLayout>
</RelativeLayout>