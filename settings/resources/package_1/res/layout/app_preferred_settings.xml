<?xml version='1.0' encoding='utf-8' ?>
<com.android.settingslib.readboy.BaseScrollView android:scrollbarStyle="@integer/preference_scrollbar_style"
                      android:clipToPadding="false"
                      android:layout_width="fill_parent"
                      android:layout_height="fill_parent" xmlns:android="http://schemas.android.com/apk/res/android">
  <LinearLayout android:orientation="vertical"
                android:paddingBottom="5.0dp"
                android:layout_width="fill_parent"
                android:layout_height="fill_parent"
                android:paddingStart="?android:attr/listPreferredItemPaddingStart"
                android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">
    <TextView android:textAppearance="?android:attr/textAppearanceSmall"
              android:id="@id/auto_launch"
              android:paddingTop="12.0dp"
              android:paddingBottom="8.0dp"
              android:layout_width="fill_parent"
              android:layout_height="wrap_content"
              android:layout_alignParentStart="true" />
    <Button android:id="@id/clear_activities_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clear_activities"
            android:layout_marginStart="0.0dp"
            style="@style/rbButtonStyle" />
  </LinearLayout>
</com.android.settingslib.readboy.BaseScrollView>