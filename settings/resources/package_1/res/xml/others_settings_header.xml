<?xml version='1.0' encoding='utf-8' ?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
  <PreferenceScreen android:title="@string/readboy_handy_gesture_title"
                    android:key="handy_gesture_settings"
                    android:fragment="com.android.settings.HandyGestureSettings" />
  <PreferenceScreen android:title="@string/readboy_navigationbar_title"
                    android:key="navigationbar_settings"
                    android:fragment="com.android.settings.NavigationBarSettings" />
  <PreferenceScreen android:title="@string/touchmode_settings"
                    android:key="touch_mode_settings"
                    android:fragment="com.android.settings.TouchModeSettings" />
  <com.android.settings.ArrowTitlePreference android:title="@string/date_and_time_settings_title"
                        android:key="date_time_settings"
                        android:fragment="com.android.settings.DateTimeSettings" />
  <com.android.settings.ArrowTitlePreference android:title="@string/language_settings"
                        android:key="language_settings"
                        android:fragment="com.android.settings.inputmethod.InputMethodAndLanguageSettings" />
  <com.android.settings.ArrowTitlePreference android:title="@string/privacy_settings_title"
                        android:key="privacy_settings"
                        android:fragment="com.android.settings.PrivacySettings" />
  <PreferenceScreen android:title="@string/auto_frozen_apps_center"
                    android:key="auto_frozen_apps_center">
    <intent android:action="com.dream.freezing.FreezingUI" />
  </PreferenceScreen>
  <com.android.settings.ArrowTitlePreference android:title="@string/readboy_show_ram_fusion_switch_title"
                        android:key="ram_fusion_settings"
                        android:fragment="com.android.settings.SettingsRamFusion" />
  <com.android.settings.ArrowTitlePreference android:title="@string/storage_settings"
                        android:key="storage_settings"
                        android:fragment="com.android.settings.deviceinfo.StorageSettings" />
  <com.android.settings.ArrowTitlePreference android:title="@string/power_usage_summary_title"
                        android:key="battery_settings"
                        android:fragment="com.android.settings.fuelgauge.PowerUsageSummary" />
  <PreferenceScreen android:persistent="false"
                    android:layout="@layout/preference_arrow_material"
                    android:title="@string/usb_connect_mode_title"
                    android:key="usb_connect_mode"
                    android:fragment="com.android.settings.deviceinfo.UsbSettings" />
  <PreferenceScreen android:title="@string/readboy_extra_launcher_all_settings_title"
                    android:key="launcher_all_about_readboy_pref"
                    android:summary="@string/readboy_extra_launcher_all_settings_summary"
                    android:fragment="com.android.settings.SettingsLauncherAllAboutReadboy" />
  <PreferenceScreen android:title="@string/readboy_extra_more_settings_title"
                    android:key="extra_more_settings_pref"
                    android:summary="@string/readboy_extra_more_settings_summary"
                    android:fragment="com.android.settings.SettingsExtraMoreSettings" />
  <PreferenceScreen android:title="@string/readboy_force_portrait_app_landscape_title"
                    android:key="force_portrait_app_landscape_pref"
                    android:summary="@string/readboy_force_portrait_app_landscape_summary"
                    android:fragment="com.android.settings.ForcePortraitAppLandscape" />
  <PreferenceScreen android:title="@string/readboy_show_other_more_settings_title"
                    android:key="other_more_funs_settings"
                    android:summary="@string/readboy_show_other_more_settings_summary"
                    android:fragment="com.android.settings.SettingsOtherMoreFuns" />
</PreferenceScreen>