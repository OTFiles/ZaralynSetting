<?xml version='1.0' encoding='utf-8' ?>
<PreferenceScreen android:title="@string/wifi_settings"
                  settings:keywords="@string/keywords_wifi" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
  <PreferenceCategory android:layout="@layout/preference_category_no_label"
                      android:key="connected_access_point"
                      android:order="10" />
  <PreferenceCategory android:layout="@layout/preference_category_1px_label"
                      android:key="access_points"
                      android:order="20" />
  <PreferenceCategory android:layout="@layout/preference_category_no_label"
                      android:key="additional_settings"
                      android:order="30">
    <Preference android:title="@string/wifi_configure_settings_preference_title"
                android:key="configure_settings"
                android:fragment="com.android.settings.wifi.ConfigureWifiSettings" />
    <Preference android:title="@string/wifi_saved_access_points_label"
                android:key="saved_networks"
                android:fragment="com.android.settings.wifi.SavedAccessPointsWifiSettings" />
  </PreferenceCategory>
</PreferenceScreen>