<?xml version='1.0' encoding='utf-8' ?>
<PreferenceScreen android:title="@string/testing" xmlns:android="http://schemas.android.com/apk/res/android">
  <PreferenceScreen android:title="@string/testing_phone_info"
                    android:key="radio_info_settings">
    <intent android:targetPackage="com.android.settings"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.settings.RadioInfo" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/testing_phone1_info"
                    android:key="radio_info1_settings">
    <intent android:targetPackage="com.android.settings"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.settings.RadioInfo">
      <extra android:name="slot"
             android:value="0" />
    </intent>
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/testing_phone2_info"
                    android:key="radio_info2_settings">
    <intent android:targetPackage="com.android.settings"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.settings.RadioInfo">
      <extra android:name="slot"
             android:value="1" />
    </intent>
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/testing_usage_stats">
    <intent android:targetPackage="com.android.settings"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.settings.UsageStatsActivity" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/testing_wifi_info">
    <intent android:targetPackage="com.android.settings"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.android.settings.Settings$WifiInfoActivity" />
  </PreferenceScreen>
</PreferenceScreen>