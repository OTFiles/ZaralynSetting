<?xml version='1.0' encoding='utf-8' ?>
<PreferenceScreen android:title="@string/about_settings" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
  <PreferenceScreen android:title="Wireless update"
                    android:key="fota_update">
    <intent android:targetPackage="com.adups.fota"
            android:targetClass="com.adups.fota.GoogleOtaClient" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/system_update_settings_list_item_title"
                    android:key="system_update_settings"
                    android:summary="@string/system_update_settings_list_item_summary">
    <intent android:action="android.settings.SYSTEM_UPDATE_SETTINGS" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/additional_system_update_settings_list_item_title"
                    android:key="additional_system_update_settings">
    <intent android:targetPackage="@string/additional_system_update"
            android:action="android.intent.action.MAIN"
            android:targetClass="@string/additional_system_update_menu" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/manual"
                    android:key="manual">
    <intent android:action="android.settings.SHOW_MANUAL" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/legal_information"
                    android:key="container"
                    android:fragment="com.android.settings.LegalSettings" />
  <PreferenceScreen android:title="@string/regulatory_labels"
                    android:key="regulatory_info">
    <intent android:action="android.settings.SHOW_REGULATORY_INFO" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/safety_and_regulatory_info"
                    android:key="safety_info">
    <intent android:action="android.settings.SHOW_SAFETY_AND_REGULATORY_INFO" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/device_feedback"
                    android:key="device_feedback" />
  <com.android.settings.DividerPreference android:enabled="false"
                        android:title="@string/rb_model_name"
                        android:selectable="false"
                        android:key="device_model"
                        android:summary="@string/device_info_default"
                        android:shouldDisableView="false"
                        settings:allowDividerAbove="true"
                        settings:allowDividerBelow="true" />
  <Preference android:title="@string/os_version"
              android:key="os_version" />
  <Preference android:enabled="false"
              android:title="@string/build_number"
              android:key="build_number"
              android:summary="@string/device_info_default"
              android:shouldDisableView="false" />
  <Preference android:enabled="false"
              android:title="@string/rb_pad_cpu_info_title"
              android:key="pad_cpu_info"
              android:summary="@string/rb_pad_cpu_info_summary"
              android:shouldDisableView="false" />
  <Preference android:enabled="false"
              android:title="@string/firmware_version"
              android:key="firmware_version"
              android:summary="@string/device_info_default"
              android:shouldDisableView="false" />
  <PreferenceScreen android:title="@string/security_patch"
                    android:key="security_patch"
                    android:summary="@string/device_info_default">
    <intent android:action="android.intent.action.VIEW"
            android:data="https://source.android.com/security/bulletin/" />
  </PreferenceScreen>
  <com.android.settings.DividerPreference android:enabled="false"
                        android:title="@string/fcc_equipment_id"
                        android:selectable="false"
                        android:key="fcc_equipment_id"
                        android:summary="@string/device_info_default"
                        android:shouldDisableView="false"
                        settings:allowDividerAbove="true"
                        settings:allowDividerBelow="true" />
  <Preference android:title="@string/status_serial_number"
              android:key="serial_number"
              android:summary="@string/summary_placeholder"
              settings:allowDividerAbove="true" />
  <Preference android:persistent="false"
              android:title="@string/readboy_show_pad_sn_serial_number_title"
              android:key="readboy_pad_device_serial_number"
              android:summary="@string/device_info_not_available"
              settings:allowDividerAbove="true" />
  <Preference android:title="@string/mbn_version"
              android:key="mbn_version"
              android:summary="@string/device_info_default"
              style="?android:attr/preferenceInformationStyle" />
  <com.android.settings.DividerPreference android:enabled="false"
                        android:title="@string/baseband_version"
                        android:selectable="false"
                        android:key="baseband_version"
                        android:summary="@string/device_info_default"
                        android:shouldDisableView="false"
                        settings:allowDividerAbove="true"
                        settings:allowDividerBelow="true" />
  <Preference android:title="@string/device_cache_size"
              android:key="device_cache_size"
              android:summary="@string/device_info_default"
              style="?android:attr/preferenceInformationStyle" />
  <Preference android:title="@string/device_memory_size"
              android:key="device_memory_size"
              android:summary="@string/device_info_default"
              style="?android:attr/preferenceInformationStyle" />
  <Preference android:title="@string/qgp_version"
              android:key="qgp_version"
              android:summary="@string/device_info_default"
              style="?android:attr/preferenceInformationStyle" />
  <com.android.settings.DividerPreference android:enabled="false"
                        android:title="@string/selinux_status"
                        android:selectable="false"
                        android:key="selinux_status"
                        android:summary="@string/selinux_status_enforcing"
                        android:shouldDisableView="false"
                        settings:allowDividerAbove="true"
                        settings:allowDividerBelow="true" />
  <Preference android:title="@string/software_version"
              android:key="software_version"
              android:summary="@string/device_info_default"
              style="?android:attr/preferenceInformationStyle" />
  <Preference android:title="@string/hardware_version"
              android:key="hardware_version" />
  <com.android.settings.DividerPreference android:enabled="false"
                        android:title="@string/kernel_version"
                        android:selectable="false"
                        android:key="kernel_version"
                        android:summary="@string/device_info_default"
                        android:shouldDisableView="false"
                        settings:allowDividerAbove="true"
                        settings:allowDividerBelow="true" />
  <PreferenceScreen android:title="@string/readboy_cmiit_id_title"
                    android:key="cmiit_id_pref"
                    android:summary="@string/readboy_cmiit_id_summary"
                    android:fragment="com.android.settings.CertificationMark" />
  <PreferenceScreen android:title="@string/device_status"
                    android:key="status_info"
                    android:summary="@string/device_status_summary"
                    android:fragment="com.android.settings.deviceinfo.DeviceInfoSettingsNew" />
  <PreferenceScreen android:persistent="false"
                    android:title="@string/readboy_user_feedback"
                    android:key="user_feedback">
    <intent android:targetPackage="com.dream.feedback"
            android:targetClass="com.dream.feedback.MainActivity" />
  </PreferenceScreen>
  <PreferenceScreen android:title="@string/readboy_export_log_title"
                    android:key="export_log_pref"
                    android:summary="@string/readboy_export_log_summary"
                    android:fragment="com.android.settings.ExportLogFragment">
    <extra android:name="readboy_export_log_type"
           android:value="101" />
  </PreferenceScreen>
</PreferenceScreen>