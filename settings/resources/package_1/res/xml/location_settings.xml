<?xml version='1.0' encoding='utf-8' ?>
<PreferenceScreen android:title="@string/location_settings_title"
                  android:key="location_settings"
                  settings:keywords="@string/keywords_location" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:settings="http://schemas.android.com/apk/res-auto">
  <PreferenceCategory android:title="@string/location_category_location_services"
                      android:key="location_services" />
  <PreferenceCategory android:title="@string/location_category_recent_location_requests"
                      android:key="recent_location_requests" />
  <Preference android:icon="@drawable/ic_chevron_right_24dp"
              android:title="@string/location_recent_location_requests_see_all"
              android:selectable="true"
              android:key="recent_location_requests_see_all_button"
              android:fragment="com.android.settings.location.RecentLocationRequestSeeAllFragment" />
  <PreferenceCategory android:key="location_advanced_settings">
    <Preference android:title="@string/location_app_level_permissions"
                android:key="app_level_permissions">
      <intent android:action="android.intent.action.MANAGE_PERMISSION_APPS">
        <extra android:name="android.intent.extra.PERMISSION_NAME"
               android:value="android.permission-group.LOCATION" />
      </intent>
    </Preference>
    <Preference android:title="@string/location_scanning_screen_title"
                android:key="location_scanning"
                android:fragment="com.android.settings.location.ScanningSettings" />
    <com.android.settingslib.RestrictedSwitchPreference android:enabled="false"
                          android:title="@string/managed_profile_location_switch_title"
                          android:selectable="true"
                          android:key="managed_profile_location_switch"
                          settings:useAdminDisabledSummary="true" />
    <CheckBoxPreference android:title="@string/assisted_gps"
                        android:key="assisted_gps"
                        android:summaryOn="@string/assisted_gps_enabled"
                        android:summaryOff="@string/assisted_gps_disabled" />
  </PreferenceCategory>
  <PreferenceCategory android:key="location_footer"
                      settings:allowDividerAbove="false" />
</PreferenceScreen>